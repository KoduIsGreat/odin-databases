# Build output
main
bin/
*.bin
*.exe

# `odin run tools/odb` drops an executable named after the package dir
/odb

# Binding/example build artifacts
bindings/sqlite/example/example
bindings/sqlite/example/main
bindings/duckdb/example/example
bindings/duckdb/example/main

# Prebuilt DuckDB libraries (~50MB each). Fetch per host with
# bindings/duckdb/fetch_libs.sh (or `just duckdb-lib`); never committed.
bindings/duckdb/lib/

# Host-built SQLite static libs (the SessionStart hook / build_libs.sh
# regenerates these per host). darwin_arm64 is checked in intentionally.
bindings/sqlite/lib/linux_amd64/
bindings/sqlite/lib/linux_arm64/
bindings/sqlite/lib/darwin_amd64/

# Local SQLite databases
test_db
*.db

# Local connection secrets for the `ss` smoke program (.env.example is tracked)
.env
examples/ss/.env
!examples/ss/.env.example

# macOS
.DS_Store

# NOTE: generated *.gen.odin files are committed (see README) so the demo and
# examples build on a fresh clone; CI verifies they stay in sync with the
# generators. They are intentionally NOT ignored.
quickstart
query_builder
