scan_Respons :: proc(rows: ^sql.Rows, dest: ^Respons, loc := #caller_location) -> sql.Error {
	if !rows.has_row {
		return sql.General_Error.No_Row
	}
	detached := sql.row_detached(rows)
	_ = detached
	for ci in 0 ..< rows.col_count {
		name := sql.row_col_name(rows, ci)
		val  := sql.row_value(rows, ci)
		_ = val
		switch name {
		case "id":
			if v, ok := val.(string); ok {
				dest.id = v if detached else strings.clone(v)
			}
		case "delivery_id":
			if v, ok := val.(string); ok {
				dest.delivery_id = v if detached else strings.clone(v)
			}
		case "completed":
			#partial switch x in val {
			case bool: dest.completed = x
			case i64:  dest.completed = x != 0
			}
		case "task_answers":
			if v, ok := val.([]byte); ok {
				if detached {
					dest.task_answers = v
				} else {
					cp := make([]byte, len(v)); copy(cp, v); dest.task_answers = cp
				}
			}
		case "created_at":
			if v, ok := val.(time.Time); ok { dest.created_at = v }
		case "updated_at":
			if v, ok := val.(time.Time); ok { dest.updated_at = v }
		case "task_version_id":
			if v, ok := val.(string); ok {
				dest.task_version_id = v if detached else strings.clone(v)
			}
		case "answers":
			if v, ok := val.(string); ok {
				dest.answers = v if detached else strings.clone(v)
			}
		}
	}
	return nil
}

scan_Respons_row :: proc(row: ^sql.Row, dest: ^Respons, loc := #caller_location) -> sql.Error {
	if row.err != nil {
		return row.err
	}
	return scan_Respons(&row.rows, dest, loc)
}

