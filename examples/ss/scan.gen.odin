		return sql.General_Error.No_Row
	}
	detached := sql.row_detached(rows)
	_ = detached
	for ci in 0 ..< rows.col_count {
		name := sql.row_col_name(rows, ci)
		val  := sql.row_value(rows, ci)
		_ = val
		switch name {
		case "study_id":
			if v, ok := val.(string); ok {
				dest.study_id = v if detached else strings.clone(v)
			}
		case "day":
			if v, ok := val.(time.Time); ok { dest.day = v }
		case "participant_tag_id":
			if v, ok := val.(string); ok {
				dest.participant_tag_id = v if detached else strings.clone(v)
			}
		case "response_count":
			if v, ok := val.(i64); ok { dest.response_count = i64(v) }
		case "completed_count":
			if v, ok := val.(i64); ok { dest.completed_count = i64(v) }
		}
	}
	return nil
}

scan_SurveyDailyCount_row :: proc(row: ^sql.Row, dest: ^SurveyDailyCount, loc := #caller_location) -> sql.Error {
	if row.err != nil {
		return row.err
	}
	return scan_SurveyDailyCount(&row.rows, dest, loc)
}

