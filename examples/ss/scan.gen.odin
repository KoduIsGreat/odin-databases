scan_ParticipantWaveOffset :: proc(rows: ^sql.Rows, dest: ^ParticipantWaveOffset, loc := #caller_location) -> sql.Error {
	if !rows.has_row {
		return sql.General_Error.No_Row
	}
	detached := sql.row_detached(rows)
	_ = detached
	for ci in 0 ..< rows.col_count {
		name := sql.row_col_name(rows, ci)
		val  := sql.row_value(rows, ci)
		_ = val
		switch name {
		case "id":
			if v, ok := val.(string); ok {
				dest.id = v if detached else strings.clone(v)
			}
		case "wave_id":
			if v, ok := val.(string); ok {
				dest.wave_id = v if detached else strings.clone(v)
			}
		case "participant_id":
			if v, ok := val.(string); ok {
				dest.participant_id = v if detached else strings.clone(v)
			}
		case "offset_days":
			if v, ok := val.(i64); ok { dest.offset_days = i64(v) }
		}
	}
	return nil
}

