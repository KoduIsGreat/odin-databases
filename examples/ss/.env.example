# Connection settings for the `ss` postgres stress/smoke program.
#
# Copy this file to `examples/ss/.env` and fill in your values:
#   cp examples/ss/.env.example examples/ss/.env
#
# `examples/ss/.env` is gitignored. The program (main.odin) loads it, builds a DSN,
# connects with the postgres driver, and runs a typed query-builder SELECT
# against the generated `studies` descriptor.
#
# Either set DATABASE_URL directly (takes precedence) ...
# DATABASE_URL=postgres://user:pass@localhost:5432/mydb?sslmode=disable
#
# ... or set the individual fields below and let the program assemble the DSN:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres
# sslmode: disable | require   (require needs the TLS build define — see README)
PGSSLMODE=disable
